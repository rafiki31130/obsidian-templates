model:
  version: 1
  kind: Table
  columns: []
pluginVersion: 1.0.0
filters:
  and:
    - type == "Deadline"
    - file.path.startsWith("pages")
    - '!file.tags.containsAny("archived")'
views:
  - type: table
    name: All
    order:
      - file.name
      - next_due
      - action
      - recurrence
      - notice_days
    columnSize:
      file.name: 177
  - type: table
    name: Upcomming
    order:
      - file.name
      - next_due
      - action
      - recurrence
      - notice_days
    columnSize:
      file.name: 177
