filters:
  and:
  - file.ext == "md"
  - '!file.inFolder("r_templates")'
  - '!file.inFolder(".trash")'
  - type && type.startsWith("SRC-")
views:
- type: table
  name: Toutes
  groupBy:
    property: type
    direction: ASC
  order:
  - file.name
  - DB_SRC_createurs
  - DB_SRC_date
  - DB_SRC_statut
  - DB_SRC_note
  - topic
- type: table
  name: En cours
  filters:
    and:
    - DB_SRC_statut == "en-cours"
  order:
  - file.name
  - type
  - DB_SRC_createurs
  - DB_SRC_debut
  - topic
- type: table
  name: À consulter
  filters:
    and:
    - DB_SRC_statut == "à-consulter"
  order:
  - file.name
  - type
  - DB_SRC_createurs
  - DB_SRC_support
  - topic
- type: table
  name: Livres
  filters:
    and:
    - type == "SRC-Livre"
  order:
  - file.name
  - DB_SRC_createurs
  - DB_SRC_editeur
  - DB_SRC_date
  - DB_SRC_statut
  - DB_SRC_note
- type: table
  name: Formations
  filters:
    or:
    - type == "SRC-Formation"
    - type == "SRC-Cours"
    - type == "SRC-Conference"
  order:
  - file.name
  - DB_SRC_createurs
  - DB_SRC_editeur
  - DB_SRC_date
  - DB_SRC_statut
  - DB_SRC_note
- type: table
  name: Terminées
  filters:
    and:
    - DB_SRC_statut == "terminé"
  order:
  - file.name
  - type
  - DB_SRC_createurs
  - DB_SRC_fin
  - DB_SRC_note
properties:
  type:
    displayName: Type de source
