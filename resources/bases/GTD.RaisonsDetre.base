filters:
  and:
  - file.ext == "md"
  - '!file.inFolder("r_templates")'
  - '!file.inFolder(".trash")'
  - (gtd_type == "raison_detre")
properties:
  file.name:
    displayName: Nom
  topic:
    displayName: Sujets
views:
- type: table
  name: Tous
  order:
  - file.name
  - topic
  sort:
  - property: file.name
    direction: ASC
