filters:
  and:
    - '!file.tags.contains("archived")'
    - file.path != this.file.path
    - or:
        - parent.contains(link(this.file.name))
        - author.contains(link(this.file.name))
        - relations.contains(link(this.file.name))
        - topic.contains(link(this.file.name))
        - person.contains(link(this.file.name))
        - if(date.isType("date"), date.format("YYYY-MM-DD") == this.file.name, date.toString().contains(this.file.name))
    - '!type.containsAny("Deadline")'
views:
  - type: list
    name: All
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 466
      file.mtime: 169
  - type: table
    name: Projects
    filters:
      and:
        - type.containsAny("Projet", "Project")
    groupBy:
      property: statut
      direction: ASC
    order:
      - file.name
      - statut
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 344
      note.statut: 160
      file.mtime: 194
  - type: table
    name: Meetings
    filters:
      and:
        - type.containsAny("Meeting", "EntretienTech")
    order:
      - file.name
      - date
      - person
      - topic
    sort:
      - property: date
        direction: DESC
    columnSize:
      file.name: 360
      note.date: 140
  - type: table
    name: Ops
    filters:
      and:
        - type.containsAny("Incident", "Changement", "Log")
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - date
      - topic
    sort:
      - property: date
        direction: DESC
    columnSize:
      file.name: 360
      note.date: 140
  - type: table
    name: Knowledge
    filters:
      and:
        - type.containsAny("Concepts", "Documentation", "Procedure", "Reference", "Memento", "Etude", "Learning")
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - topic
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 360
