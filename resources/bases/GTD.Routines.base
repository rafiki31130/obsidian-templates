filters:
  and:
    - file.ext == "md"
    - '!file.inFolder("r_templates")'
    - '!file.inFolder(".trash")'
    - (type == "GTD-Routine")
properties:
  file.name:
    displayName: Nom
  gtd_domaine:
    displayName: Domaine
  gtd_objectif:
    displayName: Objectif
  gtd_projet:
    displayName: Projet
  gtd_statut_routine:
    displayName: Statut routine
views:
  - type: table
    name: Toutes
    groupBy:
      property: gtd_statut_routine
      direction: ASC
    order:
      - file.name
      - gtd_domaine
      - gtd_objectif
      - gtd_projet
      - gtd_statut_routine
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Routines du domaine
    filters:
      and:
        - list(gtd_domaine).contains(this.file.asLink())
        - gtd_statut_routine != "9.abandonnee"
    order:
      - file.name
      - gtd_objectif
      - gtd_projet
      - gtd_statut_routine
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Revue mensuelle
    filters:
      and:
        - gtd_statut_routine != "9.abandonnee"
        - '!file.inFolder("pages/4. Archives")'
        - '!file.hasTag("archived")'
    groupBy:
      property: gtd_domaine
      direction: ASC
    order:
      - file.name
      - gtd_objectif
      - gtd_projet
      - gtd_statut_routine
    sort:
      - property: file.name
        direction: ASC
