model:
  version: 1
  kind: Table
  columns: []
pluginVersion: 1.0.0
filters:
  and:
    - type == "Deadline"
    - file.path.startsWith("pages")
    - '!file.tags.containsAny("archived")'
formulas:
  days_left: (next_due-today()).days
views:
  - type: table
    name: Upcomming
    filters:
      and:
        - formula.days_left <= notice_days
    order:
      - file.name
      - next_due
      - action
      - recurrence
      - notice_days
      - formula.days_left
      - topic
    columnSize:
      file.name: 177
      note.notice_days: 145
  - type: table
    name: All
    order:
      - next_due
      - formula.days_left
      - file.name
      - action
      - recurrence
      - notice_days
      - topic
    sort:
      - property: next_due
        direction: ASC
    columnSize:
      file.name: 177
      note.action: 306
      note.notice_days: 145
  - type: table
    name: Topic
    filters:
      and:
        - topic.contains(link(this.file.name))
    order:
      - file.name
      - next_due
      - formula.days_left
      - action
      - recurrence
    sort:
      - property: next_due
        direction: ASC
    columnSize:
      file.name: 220
      note.action: 306
