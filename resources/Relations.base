filters:
  or:
    - parent.contains(link(this.file.name))
    - relations.contains(link(this.file.name))
    - author.contains(link(this.file.name))
views:
  - type: table
    name: All
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - status
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 372
      file.mtime: 177
  - type: table
    name: Projects
    filters:
      and:
        - type.containsAny("Projet", "Project")
    order:
      - file.mtime
      - file.name
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 465
  - type: table
    name: Meetings
    filters:
      and:
        - type.containsAny("Meeting")
    order:
      - file.mtime
      - file.name
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 465
