filters:
  or:
    - parent.contains(link(this.file.name))
    - relations.contains(link(this.file.name))
    - author.contains(link(this.file.name))
views:
  - type: table
    name: All
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 466
      file.mtime: 169
  - type: table
    name: Projects
    filters:
      and:
        - type.containsAny("Projet", "Project")
    order:
      - file.mtime
      - file.name
      - status
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.mtime: 194
      file.name: 344
      note.status: 130
  - type: table
    name: Meetings
    filters:
      and:
        - type.containsAny("Meeting")
    order:
      - file.name
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
    columnSize:
      file.ctime: 158
      file.name: 465
